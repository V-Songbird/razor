{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.js\" SessionStart",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.js\" SubagentStart",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.js\" PreToolUse",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.js\" Stop",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.js\" UserPromptSubmit",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
