/docs/*

# Crash residue from tests/dispatcher.test.js, which needs a workspace
# inside the plugin root. Cleaned up on success; ignored so a failed run
# can never leave a fixture staged.
/disp-ws-*/

# Same for tests/contract.test.js, which builds its fixture projects inside
# the plugin root because the file meter exempts system-temp paths.
/contract-ws-*/

# Plugin-local session state — written at run time, never published.
.assay/
.foreman/
.scribe/
